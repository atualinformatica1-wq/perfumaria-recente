<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1920 1080" width="100%" height="100%">
  <defs>
    <radialGradient id="bgGrad" cx="50%" cy="40%" r="60%">
      <stop offset="0%" stop-color="#2d2218"/>
      <stop offset="40%" stop-color="#19130e"/>
      <stop offset="100%" stop-color="#080706"/>
    </radialGradient>
    <radialGradient id="goldGlow" cx="50%" cy="45%" r="35%">
      <stop offset="0%" stop-color="#d4af37" stop-opacity="0.35"/>
      <stop offset="50%" stop-color="#b89228" stop-opacity="0.12"/>
      <stop offset="100%" stop-color="#000000" stop-opacity="0"/>
    </radialGradient>
    <linearGradient id="glassGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#ffffff" stop-opacity="0.25"/>
      <stop offset="30%" stop-color="#f3e5ab" stop-opacity="0.10"/>
      <stop offset="70%" stop-color="#d4af37" stop-opacity="0.20"/>
      <stop offset="100%" stop-color="#110d0a" stop-opacity="0.85"/>
    </linearGradient>
    <linearGradient id="goldAccent" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#94721c"/>
      <stop offset="35%" stop-color="#f3e5ab"/>
      <stop offset="70%" stop-color="#d4af37"/>
      <stop offset="100%" stop-color="#b89228"/>
    </linearGradient>
    <linearGradient id="liquidGrad" x1="0%" y1="100%" x2="0%" y2="0%">
      <stop offset="0%" stop-color="#a37618" stop-opacity="0.9"/>
      <stop offset="70%" stop-color="#e6ca65" stop-opacity="0.7"/>
      <stop offset="100%" stop-color="#f3e5ab" stop-opacity="0.3"/>
    </linearGradient>
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="25" stdDeviation="30" flood-color="#000000" flood-opacity="0.8"/>
    </filter>
    <filter id="blurLight">
      <feGaussianBlur stdDeviation="40"/>
    </filter>
  </defs>

  <rect width="100%" height="100%" fill="url(#bgGrad)"/>
  <circle cx="960" cy="500" r="500" fill="url(#goldGlow)" filter="url(#blurLight)"/>

  <g transform="translate(960, 520)" filter="url(#shadow)">
    <rect x="-140" y="-120" width="280" height="360" rx="40" fill="url(#glassGrad)" stroke="url(#goldAccent)" stroke-width="2"/>
    <rect x="-125" y="0" width="250" height="225" rx="25" fill="url(#liquidGrad)"/>
    <rect x="-85" y="20" width="170" height="110" rx="8" fill="#120e0b" stroke="url(#goldAccent)" stroke-width="2"/>
    <text x="0" y="52" font-family="'Cormorant Garamond', Georgia, serif" font-size="12" font-weight="600" fill="#d4af37" text-anchor="middle" letter-spacing="4">ESSENCE</text>
    <text x="0" y="76" font-family="'Cormorant Garamond', Georgia, serif" font-size="20" font-weight="700" fill="#ffffff" text-anchor="middle" letter-spacing="2">L'AMBRE</text>
    <text x="0" y="98" font-family="sans-serif" font-size="8" font-weight="500" fill="#a38234" text-anchor="middle" letter-spacing="3">EAU DE PARFUM</text>
    <rect x="-35" y="-160" width="70" height="40" rx="4" fill="url(#goldAccent)" stroke="#ffe89c" stroke-width="1"/>
    <rect x="-55" y="-270" width="110" height="90" rx="12" fill="#14100c" stroke="url(#goldAccent)" stroke-width="2.5"/>
  </g>
</svg>
